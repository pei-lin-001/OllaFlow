# OllaFlow 配置文件模板
# 复制为 .env 并修改相关配置：cp .env.example .env

# 服务端口（默认 6478）
PORT=6478

# 运行环境：development / production / test
NODE_ENV=development

# 数据库路径（Docker 部署使用 file:/app/prisma/data/app.db）
DATABASE_URL="file:./prisma/data/app.db"

# ── 以下两项必须修改！ ──────────────────────────────
# API Key 加密密钥（至少 32 字符，建议用 openssl rand -hex 32 生成）
ENCRYPTION_KEY=""
# 管理后台 JWT 签名密钥（至少 16 字符，建议用 openssl rand -hex 24 生成）
JWT_SECRET=""
# ────────────────────────────────────────────────────

# Ollama Cloud 上游地址
OLLAMA_CLOUD_HOST="https://ollama.com"

# 管理员账号（首次启动自动创建，请修改默认密码！）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# 日志保留天数（0 = 永久保留）
LOG_RETENTION_DAYS=30

# 是否保存请求体/响应体到日志（生产环境建议 false，避免占用存储和泄露敏感数据）
SAVE_REQUEST_BODIES=false
SAVE_RESPONSE_BODIES=false
